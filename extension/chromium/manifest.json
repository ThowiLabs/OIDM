{
  "manifest_version": 3,
  "name": "OIDM — Open Download Manager",
  "version": "0.4.1",
  "description": "Captura descargas HTTP/HTTPS y envía las transferencias a OIDM (también MediaFire).",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OIDM — Open Download Manager"
  },
  "icons": {
    "16": "icons/oidm-16.png",
    "48": "icons/oidm-48.png",
    "128": "icons/oidm-128.png"
  },
  "key": ""
}
